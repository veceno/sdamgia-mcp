# sdamgia-mcp environment configuration
# Copy this file to .env and adjust as needed.

# Transport mode:
#   stdio  — local mode, for Claude Desktop / mcp dev  (default)
#   sse    — HTTP/SSE mode, for cloudflared remote access
MCP_TRANSPORT=stdio

# Bind address and port (only used when MCP_TRANSPORT=sse)
HOST=0.0.0.0
PORT=8080
